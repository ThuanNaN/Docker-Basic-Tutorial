# Copy to .env and adjust: cp .env.example .env
# POSTGRES_PASSWORD must be URL-safe (letters, digits, - _ . ~):
# it is placed inside the DATABASE_URL of the backend.
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bookstore
# Host port for the Gradio UI (the only published port)
FRONTEND_PORT=7860
